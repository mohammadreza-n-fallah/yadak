# ─────────────────────────────────────────────────────────────────
# Production environment for the Django backend.
# Copy to backend/.env on the server and fill in real values.
# This file is loaded by systemd (EnvironmentFile) and by deploy.sh.
# Format: KEY=value  (no quotes, no spaces around =, no `export`)
# ─────────────────────────────────────────────────────────────────

# Generate a new one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=false
ALLOWED_HOSTS=example.com,www.example.com

# Lock the API + CSRF to your real domain (use https://)
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# PostgreSQL (USE_SQLITE is intentionally NOT set, so Postgres is used)
DB_NAME=yadakstorage_shop
DB_USER=yadakstorage
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Used for the Zarinpal payment callback + redirect back to the site
SITE_URL=https://example.com
FRONTEND_URL=https://example.com

# Zarinpal — real merchant id from zarinpal.ir, and turn off sandbox for live
ZARINPAL_MERCHANT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Optional: AI support bot key (leave empty for offline fallback)
AI_API_KEY=

# Optional: Google login (must match the frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
