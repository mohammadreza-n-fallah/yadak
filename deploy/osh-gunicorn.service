# Django (Gunicorn) service.
# Install: sudo cp deploy/osh-gunicorn.service /etc/systemd/system/
# Replace __USER__ with your Linux username, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now osh-gunicorn
[Unit]
Description=osh Django (Gunicorn)
After=network.target postgresql.service

[Service]
User=__USER__
Group=www-data
WorkingDirectory=/home/__USER__/osh/backend
EnvironmentFile=/home/__USER__/osh/backend/.env
ExecStart=/home/__USER__/osh/backend/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
