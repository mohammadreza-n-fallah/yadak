# ─────────────────────────────────────────────────────────────────
# Production environment for the Next.js frontend.
# Copy to nextjs-frontend/.env.production on the server.
#
# IMPORTANT: NEXT_PUBLIC_* values are baked in at BUILD time (npm run build),
# NOT at runtime. So this file must exist BEFORE you build, and you must
# rebuild after changing any of these.
# ─────────────────────────────────────────────────────────────────

# The browser calls the API at this origin. With the single-domain Nginx
# setup, point it at your own domain (Nginx routes /api to Django).
NEXT_PUBLIC_API_URL=https://example.com

# Google login client id (same value as backend GOOGLE_CLIENT_ID). Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
